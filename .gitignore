__pycache__/
*.py[cod]
.venv/
venv/
env/

# runtime / session artifacts
_session_data/
db/*.sqlite3
db/*.sqlite3-*

# model weights (fetched at build or mounted; never commit)
weights/
*.gguf
*.onnx
*.pt
*.bin

# frontend: deps and build output are produced by `npm ci && npm run build`.
# dist/ is what the FastAPI backend serves in production (server/main.py mounts
# it at "/"), so it must exist ON THE KIOSK — but it is rebuilt, never committed.
frontend/node_modules/
frontend/dist/

.pytest_cache/
.DS_Store


# local Docker build cache / mounted HF + PaddleX weights (never commit)
.docker/

# analysis / editor tooling
graphify-out/
.claude/

# appliance first-run state + setup logs (machine-local)
runtime/
logs/
deploy/_pyinstaller_dist/
deploy/_pyinstaller_work/
deploy/*.spec
deploy/_setup_entry.py
# Keep Setup.exe in the release zip; rebuild with deploy\build_setup_exe.ps1
# (not committed — binary artifact)
Setup.exe

# Inno Setup: bundled offline installers + compiled output (binary artifacts,
# fetched/built by deploy\build_release.ps1 — never commit)
deploy/bundle/
dist/

# Real patient data / eval fixtures derived from it — NEVER commit (PII).
data/eval/real_pdf_pages/
bench/real_reports_*
bench/results/real_reports_*

# Local working notes (session summaries, strategy) — keep out of the repo.
summary.md

