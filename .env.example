# Swasthya Sathi — server-layer configuration (copy to .env, or set in the
# service unit). These tune the SERVER; the ENGINE/hardware profile is chosen
# separately by SS_ENV (see config/env/<name>.yaml).

# --- engine / hardware profile -------------------------------------------------
# One of: dev_4060 | cloud | orin   (default: dev_4060)
SS_ENV=dev_4060

# --- server bind ---------------------------------------------------------------
SS_HOST=127.0.0.1
SS_PORT=8000

# CORS allow-list, comma-separated. Leave EMPTY in the single-origin kiosk build
# (the SPA is served from this same process, so there are no cross-origin calls).
# The dev default (used when this var is unset) is the Vite dev server.
SS_ALLOWED_ORIGINS=

# --- logging -------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
SS_LOG_LEVEL=INFO

# --- model warmup --------------------------------------------------------------
# 1 = load models at startup (readiness gate) so the first patient isn't slow.
# 0 = lazy load on first use (old behaviour).
SS_WARMUP=1

# --- session lifecycle ---------------------------------------------------------
# Idle sessions (and their on-disk artifacts) are reaped after this many seconds.
SS_SESSION_TTL_SECONDS=1800
# Hard cap on concurrent in-memory sessions (LRU-evicted past this).
SS_MAX_SESSIONS=64

# --- live avatar (Brenin) billing control --------------------------------------
# Two backstops that stop a walked-away / crashed kiosk visit from billing the
# live avatar per-second (see server/main.py "avatar session reaper"):
#   IDLE  — end a call this long after the LAST kiosk heartbeat. Primary control
#           against an abandoned visit. Only enforced once the kiosk has sent at
#           least one /api/avatar/heartbeat, so it is inert (max-age only) until
#           the heartbeat-capable kiosk build is deployed.
SS_AVATAR_IDLE_S=120
#   MAX   — hard cap on total call length regardless of activity (crash backstop).
#           Set tighter (e.g. 240–300) for an aggressive stopgap before the
#           heartbeat client ships; raise it if real consults are being cut short.
SS_AVATAR_MAX_SESSION_S=600

# --- report persistence --------------------------------------------------------
# 1 = write report_v<n>.json into the session data dir when a report is sealed.
SS_PERSIST_REPORTS=1
